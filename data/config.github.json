{
  "ai": {
    "provider": "ali",
    "model": "qwen3.8-flash",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "DASHSCOPE_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 5.5,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 6.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "triton-lang",
        "repo": "triton",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Sean Goedecke",
        "url": "https://www.seangoedecke.com/rss.xml",
        "enabled": true,
        "category": "software-engineering",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending",
        "profile": "tech-news"
      },
      {
        "name": "Semianalysis",
        "url": "https://newsletter.semianalysis.com/feed",
        "enabled": true,
        "category": "semiconductors",
        "profile": "tech-news"
      },
      {
        "name": "LWN.net",
        "url": "https://lwn.net/headlines/rss",
        "enabled": true,
        "category": "linux-kernel",
        "profile": "tech-news"
      },
      {
        "name": "Bloomberg Markets",
        "url": "https://feeds.bloomberg.com/markets/news.rss",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "Bloomberg Technology",
        "url": "https://feeds.bloomberg.com/technology/news.rss",
        "enabled": true,
        "category": "tech-news",
        "profile": "tech-news"
      },
      {
        "name": "Bloomberg Business",
        "url": "https://feeds.bloomberg.com/business/news.rss",
        "enabled": true,
        "category": "business",
        "profile": "finance-news"
      },
      {
        "name": "财联社电报(RSSHub)",
        "url": "https://hub.slarker.me/cls/telegraph",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "华尔街见闻",
        "url": "https://dedicated.wallstreetcn.com/rss.xml",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "量子位",
        "url": "https://www.qbitai.com/feed",
        "enabled": true,
        "category": "ai-industry",
        "profile": "tech-news"
      }
    ],
    "google_news": {
      "enabled": true,
      "query": "site:reuters.com business",
      "language": "en",
      "country": "US",
      "ceid": "US:en",
      "max_results": 40,
      "category": "finance",
      "profile": "finance-news"
    },
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "profile": [
            "tech-news",
            "finance-news"
          ]
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 30,
    "group_by": "profile",
    "category_groups": {
      "tech-news": {
        "limit": 8,
        "categories": [
          "tech-news"
        ]
      },
      "tech-blog": {
        "limit": 2,
        "categories": [
          "tech-blog"
        ]
      },
      "finance-news": {
        "limit": 18,
        "categories": [
          "finance-news"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": null,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ]
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "last",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "title": "#{message_title}",
      "desp": "#{summary?limit=25000&split=---}"
    },
    "headers": ""
  }
}
